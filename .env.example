# Apify API token for clockworks/tiktok-scraper (crawler)
# Get it from: https://console.apify.com/settings/integrations
# Multiple tokens: repeat APIFY_API_TOKEN= lines (order = failover priority),
# or use APIFY_API_TOKEN_2 / APIFY_API_TOKENS=tok1,tok2
APIFY_API_TOKEN=
# APIFY_API_TOKEN=

# Cloudflare R2 — list-card covers (required for R2 cutover; boto3 in app/requirements.txt).
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=tiktok-covers

# Fallback only when R2_* is unset: Supabase Storage (private bucket).
# SUPABASE_URL=
# SUPABASE_SECRET_KEY=
# COVER_STORE_BUCKET=video-covers-pilot
