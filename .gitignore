# Python
__pycache__/
*.py[cod]
*.so
*.egg-info/
.dist/
build/
.venv/
.env
.streamlit/secrets.toml
.ipynb_checkpoints/

# Data: only the folder layout (.gitkeep) and READMEs are tracked, never data files.
# Directories are re-included so git can reach the placeholders inside them.
data/crawl_exports/*
data/raw/*
data/processed/**
!data/processed/**/
!data/**/.gitkeep
!data/**/README.md

# Local demo recordings and review shots may show TikTok video frames; never publish them.
demo_media/
.phase4-shots/

# Local scratch and IDE state
.virtual_documents/
anaconda_projects/
analysis.ipynb

# OS
.DS_Store
