# Data: only the folder layout (.gitkeep) and READMEs are tracked, never data files.
# Directories are re-included so git can reach the placeholders inside them.
data/crawl_exports/*
data/raw/*
data/processed/**
!data/processed/**/
!data/**/.gitkeep
!data/**/README.md

# Local demo recordings may show TikTok video frames; publish via YouTube, never the repo.
demo_media/

# OS
.DS_Store
